{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "KubeSpec": {
            "type": "object",
            "description": "#KubeSpec defines Kubernetes platform and cluster runtime configurations.",
            "additionalProperties": true,
            "properties": {
                "env": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "TZ": {
                            "type": "string"
                        }
                    }
                },
                "ingress": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "annotations": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        },
                        "class": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "class"
                    ]
                },
                "namespaces": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "storage": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "backup": {
                            "type": "string"
                        },
                        "default": {
                            "type": "string"
                        },
                        "local": {
                            "type": "string"
                        },
                        "performance": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "default"
                    ]
                },
                "type": {
                    "description": "Kubernetes distribution type",
                    "anyOf": [
                        {
                            "const": "microk8s"
                        },
                        {
                            "const": "k3s"
                        },
                        {
                            "const": "talos"
                        },
                        {
                            "const": "eks"
                        },
                        {
                            "const": "gke"
                        },
                        {
                            "const": "aks"
                        },
                        {
                            "const": "kind"
                        },
                        {
                            "const": "kwok"
                        },
                        {
                            "type": "string"
                        }
                    ]
                }
            },
            "required": [
                "type"
            ]
        }
    },
    "type": "object",
    "description": "#WithKube attaches Kubernetes platform properties.",
    "additionalProperties": true,
    "properties": {
        "kube": {
            "$ref": "#/$defs/KubeSpec"
        }
    },
    "required": [
        "kube"
    ]
}
